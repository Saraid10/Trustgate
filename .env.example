APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://payment_safety:payment_safety@127.0.0.1:5432/payment_safety
PROVIDER_CALLBACK_URL=http://api:8000/api/v1/webhooks/provider-events
# Test Mode credentials only. A Test Mode key id begins with "rzp_test_".
# A key id beginning with "rzp_live_" must never be placed in this testbed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Keep this default for Test Mode. Do not place Live Mode credentials in this testbed.
RAZORPAY_ORDERS_URL=https://api.razorpay.com/v1/orders
# Set in the Razorpay dashboard when configuring the webhook. This is a different value from
# RAZORPAY_KEY_SECRET, and the webhook signature is computed with this one.
RAZORPAY_WEBHOOK_SECRET=
# How old a signed webhook may be and still be acted on, in seconds. Defaults to 86400.
# The floor is the provider's retry horizon: set it below that and a legitimate late retry is
# dropped, which loses a real payment outcome. Duplicate delivery is already refused exactly by
# provider event identity, so this is a bound on how long a captured event stays usable rather
# than the primary replay defence.
RAZORPAY_WEBHOOK_MAX_AGE_SECONDS=
# Optional. Only read by `python -m agent.demo --live`, the single path in this project that
# contacts a model provider. The test suite never reads any of these.
# Backend is "anthropic" (needs ANTHROPIC_API_KEY), "bedrock" (needs AWS credentials, a region,
# and a valid payment instrument on the AWS account), or "groq" (free tier, needs GROQ_API_KEY
# and no payment instrument).
TRUSTGATE_MODEL_BACKEND=anthropic
# Optional override. Defaults per backend: claude-opus-5, anthropic.claude-haiku-4-5, or
# llama-3.3-70b-versatile.
TRUSTGATE_MODEL_ID=
# Groq only. Free tier, no card required. Create one at https://console.groq.com
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Bedrock only. AWS_REGION must match the region the Bedrock key was created in.
AWS_REGION=
# Standard AWS fallback, honoured when AWS_REGION is unset.
AWS_DEFAULT_REGION=
# A Bedrock API key is a bearer token and is the simplest path; it needs no AWS signing extra.
AWS_BEARER_TOKEN_BEDROCK=
# Alternatively, SigV4 signing through the standard AWS credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
INTERNAL_ADMIN_TOKEN=
PROVIDER_WEBHOOK_SECRET=
MCP_TENANT_ID=
MCP_ACTOR_ID=
TRUSTGATE_API_ACTOR_ID=
DEMO_APPROVER_TOKEN=
DEMO_APPROVER_ID=
ENABLE_LEGACY_PAYMENT_REQUEST_API=false

# Serves the read-only demo console at /console/{tenant_id}. Unset means 404: it is a
# demonstration surface and carries tenant identity in the URL, so it is opt-in.
ENABLE_CONSOLE=
